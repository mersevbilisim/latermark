<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Flutter ilk karesini çizene kadar gösterilen native başlangıç yüzeyi. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:navigationBarColor">@color/latermark_splash_background</item>
        <item name="android:statusBarColor">@color/latermark_splash_background</item>
    </style>
    <!-- Native splash ile Flutter'ın ilk karesi arasında renk sıçraması olmasın. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/latermark_splash_background</item>
    </style>
</resources>
