<?xml version="1.0" encoding="utf-8"?>
<!--
  Ana ekran widget'ı. Kare tam sayfa, yazı üstünde koyu bir perdenin üzerinde.
  Köşe yuvarlaması Android 12+ üzerinde koddan (setViewOutlinePreferredRadius)
  verilir; daha eski sürümlerde arka plan çizimi devreye girer.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/widget_photo_description" />

    <View
        android:id="@+id/widget_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_scrim" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.16"
            android:textColor="#52F3F1ED"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#F3F1ED"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textSize="11sp"
            android:textColor="#8CF3F1ED" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_expiry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:background="@drawable/widget_pill"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#F3F1ED" />

    <LinearLayout
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_aperture"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:contentDescription="@string/widget_empty_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/widget_empty_title"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#F3F1ED" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/widget_empty_subtitle"
            android:textSize="11sp"
            android:textColor="#52F3F1ED" />
    </LinearLayout>
</FrameLayout>
