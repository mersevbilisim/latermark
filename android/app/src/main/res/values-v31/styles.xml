<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ zorunlu sistem splash'ı: tam ikon değil, güvenli alandaki amblem. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/latermark_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/latermark_splash_mark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/latermark_splash_background</item>
        <item name="android:windowBackground">@color/latermark_splash_background</item>
        <item name="android:navigationBarColor">@color/latermark_splash_background</item>
        <item name="android:statusBarColor">@color/latermark_splash_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/latermark_splash_background</item>
    </style>
</resources>
